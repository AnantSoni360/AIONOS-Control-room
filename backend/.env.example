# ============================================================
# AIONOS Agentic AI Factory - Environment Variables
# Copy this file to .env and fill in real values.
# -----------------------------------------------------------------------------
# Groq (LLM Engine - ultra-fast inference)
# Required for using the Groq provider (llama-3.3-70b-versatile)
# -----------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here

# Bug #9 fixed: these two keys were missing from the example file

# Mistral AI (LLM Engine - default provider)
# Required for using the Mistral provider (mistral-large-latest)
# Get your key at: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# Google AI (RAG Embeddings)
# Required for the RAG pipeline - used to embed SOP policy documents
# Get your key at: https://ai.google.dev/
GOOGLE_API_KEY=your_google_ai_api_key_here

# ── Supabase ────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Direct DB (for schema migrations)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
# Pooler URL (use this if direct connection times out)
DATABASE_URL_POOLER=postgresql://postgres.your-project:password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ── JWT ─────────────────────────────────────────────────────
# Leave blank to auto-use SUPABASE_SERVICE_ROLE_KEY as JWT secret
JWT_SECRET=
JWT_ALGORITHM=HS256

# ── Agent Limits ────────────────────────────────────────────
AGENT_TIMEOUT_SECONDS=120
AGENT_MAX_RETRIES=2

# ── Rate Limits ─────────────────────────────────────────────
RATE_LIMIT_AGENTS=10/minute
RATE_LIMIT_SUPERVISOR=5/minute
RATE_LIMIT_DEFAULT=120/minute

# ── App ─────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
